# Normalize line endings across platforms (important for a cross-OS public repo).
* text=auto

# Explicitly declare text files.
*.rs    text
*.toml  text
*.md    text
*.yml   text
*.yaml  text
*.sh    text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf

# Never touch binary files.
*.png   binary
*.jpg   binary
*.zip   binary
*.gz    binary
