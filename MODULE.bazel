module(name = "llama", version = "0.1.0")

# Rust rules for Bazel. 0.74.0 supports Bazel 9.
bazel_dep(name = "rules_rust", version = "0.74.0")

###############################################################################
# R U S T   T O O L C H A I N
# Pinned so every machine compiles with the exact same compiler.
###############################################################################
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(versions = ["1.98.0"])
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

###############################################################################
# C R A T E S
# Single source of truth = `Cargo.toml` / `Cargo.lock` at the repo root. Bazel
# reads them via `from_cargo`, and the CI/release builds use plain `cargo`, so
# the two can never drift. (If you edit deps, run: `cargo build` then
# `CARGO_BAZEL_REPIN=1 bazel build //...` to re-pin.)
###############################################################################
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")
